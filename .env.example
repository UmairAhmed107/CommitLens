# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection
# If MongoDB is running locally, use mongodb://localhost:27017/scit_db
# Set USE_IN_MEMORY_DB=true to automatically boot an embedded MongoDB instance for quick local evaluation
MONGODB_URI=mongodb://localhost:27017/scit_db
USE_IN_MEMORY_DB=false

# Authentication
JWT_SECRET=supersecretjwtkey_scit_system_2026_change_impact_secure
JWT_EXPIRE=24h

# Security: AES 256-bit Hex Key for Encrypting GitHub Tokens (64 hex characters)
AES_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# GitHub Webhook HMAC Secret
GITHUB_WEBHOOK_SECRET=scit_github_webhook_secret_key_12345
