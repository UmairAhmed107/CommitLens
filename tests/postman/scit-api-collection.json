{
  "info": {
    "_postman_id": "scit-change-impact-collection-v1",
    "name": "Smart Change Impact & Test Management System API",
    "description": "Comprehensive Postman test collection for all SCIT REST endpoints (System Design Section 4)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "projectId", "value": "", "type": "string" },
    { "key": "reqId", "value": "REQ-01", "type": "string" },
    { "key": "testId", "value": "TC-01", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User (FR-AUTH-01)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Engineer\",\n  \"email\": \"test.qa@demo.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login (FR-AUTH-02)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) { pm.environment.set('token', res.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pm@demo.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Projects",
      "item": [
        {
          "name": "List Projects (FR-PRJ-03)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/projects", "host": ["{{baseUrl}}"], "path": ["projects"] }
          }
        },
        {
          "name": "Create Project (FR-PRJ-01)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"E-Commerce Webapp\",\n  \"description\": \"Payment and checkout core services\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/projects", "host": ["{{baseUrl}}"], "path": ["projects"] }
          }
        }
      ]
    },
    {
      "name": "3. Requirements & Tests",
      "item": [
        {
          "name": "List Requirements (FR-REQ-04)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/requirements", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "requirements"] }
          }
        },
        {
          "name": "Create Requirement (FR-REQ-01)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"User Self-Service Profile Edit\",\n  \"description\": \"Allow user to update avatar and contact information\",\n  \"type\": \"functional\",\n  \"priority\": \"Medium\",\n  \"status\": \"Active\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/requirements", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "requirements"] }
          }
        },
        {
          "name": "List Test Cases (FR-TST-01)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/tests", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "tests"] }
          }
        },
        {
          "name": "Requirement Coverage Stats (FR-REQ-05)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/coverage", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "coverage"] }
          }
        }
      ]
    },
    {
      "name": "4. Git & Impact Engine",
      "item": [
        {
          "name": "Sync Commits & Run Impact Engine (FR-GIT-03, FR-IMP-03)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/sync", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "sync"] }
          }
        },
        {
          "name": "List Ingested Commits (FR-GIT-06)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/commits", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "commits"] }
          }
        },
        {
          "name": "Get Impact Analysis for Commit (FR-IMP-03 to FR-IMP-07)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/commits/a1b2c3d4e5f67890123456789abcdef012345678/impact?projectId={{projectId}}", "host": ["{{baseUrl}}"], "path": ["commits", "a1b2c3d4e5f67890123456789abcdef012345678", "impact"], "query": [{ "key": "projectId", "value": "{{projectId}}" }] }
          }
        }
      ]
    },
    {
      "name": "5. Dashboards & Reports",
      "item": [
        {
          "name": "PM Dashboard View (FR-DSH-01)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/dashboard/project", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "dashboard", "project"] }
          }
        },
        {
          "name": "Requirement Traceability Matrix Preview (FR-RPT-01)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/reports/rtm", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "reports", "rtm"] }
          }
        },
        {
          "name": "Export RTM as PDF (FR-RPT-04)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/reports/rtm/export?format=pdf", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "reports", "rtm", "export"], "query": [{ "key": "format", "value": "pdf" }] }
          }
        },
        {
          "name": "Export RTM as Excel (FR-RPT-04)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/reports/rtm/export?format=xlsx", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "reports", "rtm", "export"], "query": [{ "key": "format", "value": "xlsx" }] }
          }
        }
      ]
    }
  ]
}
